		h("AlertDialog", {
			open: Boolean(model.confirm),
			title: model.confirm === "replace" ? label("换新邮箱？", "Replace inbox?") : label("删除当前邮箱？", "Delete inbox?"),
			message: label("当前地址与邮件将无法继续使用。", "The current address and messages will no longer be available."),
			buttons: [label("取消", "Cancel"), model.confirm === "replace" ? label("换新", "Replace") : label("删除", "Delete")],
			onAction: (index) => {
